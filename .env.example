# Copia este fichero como .env y pon tu clave. El .env está en .gitignore: nunca se sube al repositorio.
LLM_API_KEY=

# Sirve cualquier proveedor compatible con la API de OpenAI. Por defecto, Gemini (nivel gratuito):
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Fijamos una versión concreta (no un alias '-latest') para que la evaluación sea reproducible.
# En nov. 2026, en el nivel gratuito, los modelos flash completos daban 503 (saturados) o 429 (sin cuota).
LLM_MODEL=gemini-3.5-flash-lite

# Alternativas:
#   Groq:          LLM_BASE_URL=https://api.groq.com/openai/v1
#   Ollama local:  LLM_BASE_URL=http://localhost:11434/v1   (LLM_API_KEY puede ser cualquier texto)
